# Server Configuration
port=8000

# Slack Configuration
slack_bot_token=your_slack_bot_token_here
slack_app_token=your_slack_app_token_here
slack_signing_secret=your_slack_signing_secret_here
bot_user_id=your_bot_user_id_here

# OpenAI Configuration
openai_api_key=your_openai_api_key_here
openai_model=gpt-4-turbo-preview
openai_temperature=0.7
openai_max_tokens=2048

# Redis Configuration
redis_host=localhost
redis_port=6379
redis_db=0
redis_password=your_redis_password_here

# MongoDB Configuration
mongodb_uri=your_mongodb_connection_string_here
mongodb_db_name=your_database_name_here

# Mailgun Configuration
mailgun_api_key=your_mailgun_api_key_here
mailgun_domain=your_mailgun_domain_here
mailgun_from_email=your_from_email_here
mailgun_from_name=your_from_name_here
mailgun_webhook_signing_key=your_webhook_signing_key_here

# YouTube Configuration
youtube_api_key=your_youtube_api_key_here

# Apify Configuration
apify_api_token=your_apify_api_token_here

# Shopify Configuration
shopify_api_key=your_shopify_api_key_here
shopify_api_secret=your_shopify_api_secret_here
shopify_store_url=your-store.myshopify.com

# Twitter/X Configuration
twitter_api_key=your_twitter_api_key_here
twitter_api_secret=your_twitter_api_secret_here
twitter_access_token=your_twitter_access_token_here
twitter_access_token_secret=your_twitter_access_token_secret_here
twitter_bearer_token=your_twitter_bearer_token_here

# LinkedIn Configuration
linkedin_access_token=your_linkedin_access_token_here
linkedin_person_id=your_linkedin_person_id_here

# Facebook Configuration
facebook_access_token=your_facebook_access_token_here
facebook_page_id=your_facebook_page_id_here

# Instagram Configuration
instagram_access_token=your_instagram_access_token_here
instagram_account_id=your_instagram_account_id_here

# Response Settings
max_response_length=2000
response_timeout=30
enable_threading=true
show_typing_indicator=true

# Scheduler Settings
scheduler_timezone=Asia/Kolkata

# Rate Limiting
rate_limit_per_user=100
rate_limit_window=60
